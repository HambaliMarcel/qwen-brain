# llama.cpp
LLAMA_SERVER=C:\AI\llama.cpp\llama-server.exe

# ASR (qwen3-asr-stream llama-server on 9999). Keep the Q8 mmproj audio tower.
# Q4_K_M loops far less than Q4_0 on sung input; Q4_0 is the fallback.
QWEN_ASR_MODEL=C:\AI\models\Qwen3-ASR-1.7B-Q4_K_M.gguf
QWEN_ASR_MMPROJ=C:\AI\models\mmproj-Qwen3-ASR-1.7B-Q8_0.gguf
# 1 = audio encoder on CPU (-900 MB VRAM, hops ~130ms -> ~500ms). Only when the GPU is full.
QWEN_ASR_MMPROJ_CPU=0

# Local 27B brain (separate from ASR on port 9999)
QWEN_BRAIN_MODEL=C:\AI\models\Qwen3.8-27B-Uncensored-YMQ-XS-TI.gguf
QWEN_BRAIN_HOST=127.0.0.1
QWEN_BRAIN_PORT=8080
QWEN_BRAIN_CTX=3072
QWEN_BRAIN_NGL=99
QWEN_BRAIN_KV=q4_0
QWEN_BRAIN_BATCH=256
QWEN_BRAIN_UBATCH=128
QWEN_BRAIN_SPEC_TYPE=draft-mtp
QWEN_BRAIN_SPEC_DRAFT_N_MAX=2
# Casual reply budget (one spoken line). Detail asks use QWEN_BRAIN_MAX_TOKENS_LONG.
QWEN_BRAIN_MAX_TOKENS=48
QWEN_BRAIN_MAX_TOKENS_LONG=384

# Live STT bus published by qwen3-asr-stream integrator
QWEN_BRAIN_STT_HOST=127.0.0.1
QWEN_BRAIN_STT_PORT=18765

# Future: Hermes Agent API (default Hermes gateway)
HERMES_API=http://127.0.0.1:8642
HERMES_API_KEY=

# Future: TTS (unset = text only)
TTS_BACKEND=off
